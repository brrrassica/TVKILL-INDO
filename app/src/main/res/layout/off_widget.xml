<!-- RemoteViews only supports platform widgets, so AppCompat's app:tint is
     not available here; android:tint is applied by the launcher on inflation. -->
<ImageButton xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/killWidget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000"
    android:src="@drawable/ic_power_settings_new_black_48dp"
    android:tint="@color/white"
    tools:ignore="UseAppTint" />

