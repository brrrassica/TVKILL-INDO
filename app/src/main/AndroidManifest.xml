<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.TRANSMIT_IR" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-feature android:name="android.hardware.consumerir" android:required="false" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name="tech.alatcerdas.tvkillindo.MainActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="tech.alatcerdas.tvkillindo.Preferences"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="tech.alatcerdas.tvkillindo.Preferences" />
                <category android:name="android.intent.category.PREFERENCE" />
            </intent-filter>
        </activity>

        <!-- Compose brand-list screen (M3 slice). Not exported and not the
             launcher: the legacy MainActivity stays user-facing until the
             Compose rewrite reaches feature parity. -->
        <activity
            android:name="tech.alatcerdas.tvkillindo.ui.brandlist.BrandListActivity"
            android:label="@string/app_name"
            android:exported="false" />

        <!-- Compose universal-mode screen (M3 slice). -->
        <activity
            android:name="tech.alatcerdas.tvkillindo.ui.universal.UniversalActivity"
            android:label="@string/menu_universal_mode"
            android:exported="false" />

        <!-- Compose shell (M3 slice): bottom navigation hosting universal,
             brands and repetitive screens. Not exported and not the launcher:
             the legacy MainActivity stays user-facing until the Compose
             rewrite reaches feature parity. -->
        <activity
            android:name="tech.alatcerdas.tvkillindo.ui.ComposeShellActivity"
            android:label="@string/app_name"
            android:exported="false" />

        <service
            android:name=".TransmitService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="infrared_tv_power_off" />
        </service>

        <receiver
            android:name=".widget.OffWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/off_widget_provider_info" />
        </receiver>

    </application>

</manifest>
